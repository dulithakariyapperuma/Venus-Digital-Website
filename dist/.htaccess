# Venus Digital: security settings for Hostinger (upload into public_html).
# If public_html already has a .htaccess, keep its lines and paste these below them.
# Hostinger already redirects http:// to https://, so there's no HTTPS rule here (adding one can cause a redirect loop).

# --- One address for the site ---
# Uses the address the visitor typed (THE_REQUEST), so it works whether this folder is the site root
# or sits in public_html/dist/ behind the repository's root .htaccess.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Old /dist/... addresses -> the clean address.
  RewriteCond %{THE_REQUEST} \s/dist/([^\s?]*) [NC]
  RewriteRule ^ https://venusdigital.org/%1 [R=301,L]
  # www.venusdigital.org -> venusdigital.org
  RewriteCond %{HTTP_HOST} ^www\.venusdigital\.org$ [NC]
  RewriteCond %{THE_REQUEST} \s([^\s?]*)
  RewriteRule ^ https://venusdigital.org%1 [R=301,L]
</IfModule>

# --- Hide files and folders whose names start with a dot (.git, .env, .DS_Store...) ---
# /.well-known/ stays open because the SSL certificate renewal needs it.
RedirectMatch 404 "/\.(?!well-known/)"

<IfModule mod_headers.c>
  # Browsers must use HTTPS for this site for the next year.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Other websites can't show your pages inside a frame (stops click-jacking tricks).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Browsers must trust the file types the server sends.
  Header always set X-Content-Type-Options "nosniff"
  # Other sites only see "venusdigital.org" when visitors follow a link, never the full page address.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The site never needs the camera, microphone, location, payments or USB.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Pages the site opens in a new tab (like the booking page) can't reach back into it.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Content-Security-Policy: the page may only load code, fonts, frames and media from these places.
  # If you add a new outside service (a chat widget, analytics, a new video host), add its address here,
  # or it will be blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-src https://player.vimeo.com https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
